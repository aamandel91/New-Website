# Mapbox API Key - for maps and location features
# Get yours at: https://www.mapbox.com/
NEXT_PUBLIC_MAPBOX_KEY=pk.eyJ1IjoiYWFtYW5kZWw5MSIsImEiOiJjbWlkNWJpNWswMnEwMmtwbzFiMWF2NjM1In0.8ZsLFb1rrdPNVRnmUYvy3Q

# Google Maps API Key - for Street View and location features
# Get yours at: https://console.cloud.google.com/
NEXT_PUBLIC_GMAPS_KEY=AIzaSyAZjiWaP3e-jYcQVeMMsTVdnr8rohIbW10

# Application Domain - your website's public URL
NEXT_PUBLIC_APP_DOMAIN=http://localhost:3000

# Site URL - used for internal API calls
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =============================================================================
# OPTIONAL ENVIRONMENT VARIABLES
# =============================================================================

# Google Analytics - Tracking ID (optional)
# NEXT_PUBLIC_GTAG_KEY=

# Google Tag Manager - Container ID (optional)
# NEXT_PUBLIC_GTM_KEY=

# reCAPTCHA - Site Key for form protection (optional)
# Get yours at: https://www.google.com/recaptcha/admin
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# FollowUpBoss CRM Integration (optional)
# NEXT_PUBLIC_FOLLOWUPBOSS_ENABLED=false
# NEXT_PUBLIC_FOLLOWUPBOSS_ID=
# NEXT_PUBLIC_FUB_URL=

# Tawk.to Live Chat Integration (optional)
# NEXT_PUBLIC_TAWK_ENABLED=false
# NEXT_PUBLIC_TAWK_ID=

# GrowthBook Feature Flags (optional)
# NEXT_PUBLIC_GROWTHBOOK_INIT=ssg
# NEXT_PUBLIC_GROWTHBOOK_DEV_MODE=false

# Debug Mode - Enable tracking event logs (optional)
# NEXT_PUBLIC_DEBUG_TRACKING_EVENTS=false

# Application Configuration - i18n settings (optional)
# NEXT_PUBLIC_APP_CONFIGURATION=
