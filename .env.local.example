# ============================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local
#
# NEVER commit .env.local to Git — it contains secrets.

# Backend API URL (the backend proxy runs on port 8080)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Your site's public domain (localhost for dev, your real domain for production)
NEXT_PUBLIC_APP_DOMAIN=http://localhost:3000

# Mapbox API key for maps and location autocomplete
# Get yours free at: https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_KEY=pk.your_mapbox_public_token_here

# Google Tag Manager container ID
# Get yours at: https://tagmanager.google.com/
# Leave as placeholder until you have a real GTM container
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Facebook Pixel ID (optional — for remarketing)
# Get yours at: https://business.facebook.com/events_manager/
NEXT_PUBLIC_FB_PIXEL_ID=

# SureSend CRM Pixel ID (optional — for CRM tracking)
# Get yours at: SureSend Settings > Pixel Tracking
NEXT_PUBLIC_SURESEND_PIXEL_ID=SS-XXXXXXXXXX

# ============================================
# IMPORTANT CONFIGURATION NOTE
# ============================================
# After setting up .env.local, you also need to update:
#   src/configs/defaults/search.ts
#     - Change defaultBoardId to 110 (Florida MLS)
#     - Change vowBoardId to 110
#
# This is hardcoded in the config, not an env variable.
