# ============================================
# REQUIRED CONFIGURATION
# ============================================
# These settings are required for the application to function properly

# Application Configuration
APP_SETTINGS_PRESET=defaults
APP_ENVIRONMENT=localhost
PORT=8080

# Repliers API Configuration
# Configure your Repliers API settings for real estate data access
# Get your API key by creating a free account at https://login.repliers.com/
REPLIERS_BASE_URL=https://api.repliers.io
REPLIERS_API_LIMIT=1
REPLIERS_API_INTERVAL_MS=1000
REPLIERS_API_KEY=<your_repliers_api_key>

# Mapbox Configuration
# Mapbox API key is required for location and mapping features
# Create a free account at https://www.mapbox.com/ to obtain your API key
MAPBOX_ACCESS_TOKEN=<your_mapbox_api_key>

# JWT Configuration
# Generate local JWT keys by running: npm run jwt:generate
JWT_PUBLIC_KEY=keys/public.pem
JWT_PRIVATE_KEY=keys/private.pem
JWT_EXPIRE=24h

# Anthropic Claude API (required for AI content generation)
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=<your_anthropic_api_key>

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespw
DB_NAME=repliers
# DB_USE_SSL=false

# ============================================
# OPTIONAL: GOOGLE MAPS API
# ============================================
# Alternative to Mapbox for autosuggest functionality
# Required when REPLIERS_AUTOSUGGEST_PROVIDER=googlemaps
# Get your API key at https://console.cloud.google.com/
# GOOGLE_MAPS_API_KEY=<your_google_maps_api_key>
# GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com/maps/api
# GOOGLE_MAPS_TIMEOUT_MS=30000

# ============================================
# OPTIONAL: GOOGLE CLOUD CREDENTIALS
# ============================================
# Required in hosted/production environments (when APP_ENVIRONMENT != localhost)
# GOOGLE_CREDENTIALS=<your_google_cloud_credentials_json>

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOGLEVEL=info
# Logtail Token for log aggregation service
# LOGTAIL_TOKEN=<your_logtail_token>

# ============================================
# OPTIONAL: OAUTH PROVIDERS
# ============================================
# Google OAuth Configuration
# Get credentials at https://console.cloud.google.com/apis/credentials
# OAUTH_GOOGLE_CLIENT_ID=<your_client_id>
# OAUTH_GOOGLE_CLIENT_SECRET=<your_client_secret>
# OAUTH_GOOGLE_REDIRECT_URI=<your_redirect_uri>

# Facebook OAuth Configuration
# Get credentials at https://developers.facebook.com/apps/
# OAUTH_FACEBOOK_CLIENT_ID=<your_client_id>
# OAUTH_FACEBOOK_CLIENT_SECRET=<your_client_secret>
# OAUTH_FACEBOOK_REDIRECT_URI=<your_redirect_uri>

# ============================================
# OPTIONAL: SOCIAL MEDIA INTEGRATION
# ============================================
# Pinterest Integration
# Get credentials at https://developers.pinterest.com/apps/
# SOCIAL_PINTEREST_CLIENT_ID=<your_client_id>
# SOCIAL_PINTEREST_CLIENT_SECRET=<your_client_secret>
# SOCIAL_PINTEREST_REDIRECT_URI=<your_redirect_uri>

# ============================================
# OPTIONAL: FOLLOWUPBOSS CRM INTEGRATION
# ============================================
# FollowUpBoss API Configuration
# Get credentials at https://app.followupboss.com/settings/api
# BOSS_ENABLED=true
# BOSS_BASEURL=https://api.followupboss.com/v1
# BOSS_TIMEOUT_MS=30000
# BOSS_USERNAME=<your_username>
# BOSS_PASSWORD=<your_password>
# BOSS_SYSTEM=<unique_system_name>
# BOSS_SYSTEM_KEY=<your_system_key>
# BOSS_DEFAULT_SOURCE=example.tld
# BOSS_DEFAULT_ASSIGNED_TO=Default Agent
# BOSS_DEFAULT_TAGS=dev
# BOSS_PROPERTY_URL=https://example.tld/listing/[MLS_NUMBER]?boardId=[BOARD_ID]
# BOSS_CLIENT_URL=https://example.tld/agent/client/[CLIENT_ID]
# BOSS_ESTIMATE_URL=https://example.tld/estimate/[ESTIMATE_ID]
# BOSS_SAVED_SEARCH_URL=
# BOSS_CUSTOM_FIELDS_STRATEGY=
# BOSS_CUSTOM_AVM_FIELD=
# BOSS_REPORT_CLIENT_VIEW_ESTIMATE=false

# Webhook Configuration
# BOSS_WEBHOOK_ENABLED=false
# BOSS_WEBHOOK_BASEURL=https://localhost:3000/webhook
# BOSS_WEBHOOK_USE_NGROK=false
# BOSS_WEBHOOK_CLIENT_TAGS_CSV=

# ============================================
# OPTIONAL: NGROK (for webhook development)
# ============================================
# Required when BOSS_WEBHOOK_USE_NGROK=true
# Get your authtoken at https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=<your_ngrok_authtoken>

# ============================================
# OPTIONAL: SMTP/EMAIL CONFIGURATION
# ============================================
# SMTP_ENABLED=false
# GMAIL_USER=<your_gmail_address>
# GMAIL_APP_PASSWORD=<your_gmail_app_password>

# ============================================
# OPTIONAL: NATS MESSAGE QUEUE
# ============================================
# NATS_ENABLED=false
# NATS_SERVER=localhost:4222
# NATS_NAME=dev-portal
# NATS_CREDS=
# NATS_WORKER_CONSUMER_STREAM=boss-people
# NATS_WORKER_CONSUMER_NAME=boss-people-worker

# ============================================
# OPTIONAL: AUTHENTICATION CONFIGURATION
# ============================================
# Agent Signature Salt
# AUTH_AGENTS_SIGNATURE_SALT=repliers123

# OTP (One-Time Password) Configuration
# AUTH_OTP_TTL_MS=600000
# AUTH_OTP_RESEND_TTL_MS=60000
# AUTH_OTP_URI=http://localhost:3000/auth/otp/processing
# AUTH_OTP_MESSAGE=Please click on the link below to login
# AUTH_OTP_MESSAGE_TYPE=link_and_code
# DEBUG_AUTH_OTP_EXPOSE_CODE=false

# Email Token Configuration
# AUTH_EMAILTOKEN_ENABLED=false
# AUTH_EMAILTOKEN_EXPIRE=30d
# AUTH_EMAILTOKEN_AUTO_OTP=false

# JWT Issuer and Role-specific Expiration
# JWT_ISSUER=http://repliers-proxy
# AGENT_JWT_EXPIRE=1d

# ============================================
# OPTIONAL: CORS CONFIGURATION
# ============================================
# Comma-separated list of allowed domains
# APP_CORS_DOMAIN=http://localhost:3000

# ============================================
# OPTIONAL: SWAGGER DOCUMENTATION
# ============================================
APP_USESWAGGER=true

# ============================================
# APPLICATION SETTINGS
# ============================================
APP_STATSTOP_LIMIT=100
# APP_DISABLE_PERSISTENCE=false

# Board IDs Configuration
APP_DEFAULTS_BOARDIDS=110
APP_LOCATIONS_BOARDID=110
SETTINGS_SCRUBBING_BOARDIDS=110
SETTINGS_SCRUBBING_PROCESS_DUPLICATES_ENABLED=true
# SETTINGS_SCRUBBING_FORCE_DISPLAY_PUBLIC_YES=false
# DUPLICATES_REFERENCE_BOARD_RESOURCE_ID=9997

# Events Collection Configuration
SETTINGS_EVENTS_COLLECTOR_DEFAULT_BOARD_ID=2
# SETTINGS_EVENTS_COLLECTOR_URL_HOST=

# Property Settings
SETTINGS_EXTENDED_PROPERTY_DETAILS=false
# SETTINGS_VALIDATION_VERSION=

# Listings Display Configuration
# APP_HIDE_UNAVAILABLE_LISTINGS_STATUSES=Ter
# APP_HIDE_UNAVAILABLE_LISTINGS_HTTP_CODE=410

# ============================================
# OPTIONAL: LOCATION/PROXIMITY SEARCH
# ============================================
# PROXIMITY_SEARCH_LAT=45.420779
# PROXIMITY_SEARCH_LONG=-75.69791
# PROXIMITY_SEARCH_RADIUS_METERS=150000
# PROXIMITY_SEARCH_COUNTRY=ca
# PROXIMITY_SEARCH_LANGUAGE=en
# PROXIMITY_SEARCH_REGION_CODE=

# Autosuggest Configuration
# REPLIERS_AUTOSUGGEST_PROVIDER=mapbox
# REPLIERS_AUTOSUGGEST_MAX_RESULTS=10
# REPLIERS_AUTOSUGGEST_MAX_RESULTS_DEFAULT=3

# ============================================
# OPTIONAL: LOCATION SETTINGS
# ============================================
# SETTINGS_LOCATIONS_DROP_COORDINATES=false
# SETTINGS_LOCATIONS_ALLOW_ALL_AREAS=false
# SETTINGS_LOCATIONS_ALLOWED_AREAS=
# SETTINGS_LOCATIONS_ACTIVE_COUNT_LIMIT=5

# ============================================
# OPTIONAL: ESTIMATES CONFIGURATION
# ============================================
# SETTINGS_MAX_ESTIMATE_ID=100000
# REPLIERS_ESTIMATES_SEND_EMAIL_NOW=false
# REPLIERS_ESTIMATES_SEND_EMAIL_MONTHLY=false

# ============================================
# OPTIONAL: REPLIERS EXTRA KEYS
# ============================================
# Additional API keys for extended functionality
# REPLIERS_API_KEY_EXTRA=<your_extra_api_key>
# REPLIERS_AGENT_ID=0
# REPLIERS_UNAUTHENTICATED_CLIENT_ID=0
# REPLIERS_AGENT_EMAIL=
# REPLIERS_PROXY_XFF=false
# REPLIERS_TIMEOUT=30000

# ============================================
# OPTIONAL: XFF (X-Forwarded-For) CONFIGURATION
# ============================================
# XFF_SSR_TOKEN=
# XFF_SSG_TOKEN=
# XFF_SSR_IPADDR_OFFSET=2

# ============================================
# OPTIONAL: CACHE CONFIGURATION
# ============================================
# TTL in milliseconds (default: 24 hours = 86400000)
# CACHE_STATSWIDGET_TTL=86400000
# CACHE_NEIGHBORHOODSRANKING_TTL=86400000
# CACHE_AUTOSUGGEST_LOCATIONS_TTL=86400000
# CACHE_LISTINGS_COUNT_TTL=86400000
