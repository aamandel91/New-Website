# -----------------------------------------------------------------------------
# Environment Variables Configuration
# -----------------------------------------------------------------------------
# This file shows all the environment variables used by the application.
# Copy this file to .env.local and fill in your actual values.
# See: https://nextjs.org/docs/app/guides/environment-variables

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Base URL for the Repliers portal backend API
# In development, this typically points to your local backend server
# See: https://github.com/Repliers-io/portal-backend
NEXT_PUBLIC_API_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Mapbox Configuration
# -----------------------------------------------------------------------------
# Mapbox API key for location and mapping features
# Create a free account at https://www.mapbox.com/ to obtain your API key
# This key will be bundled with the client-side code
NEXT_PUBLIC_MAPBOX_KEY=your_mapbox_api_key_here

# -----------------------------------------------------------------------------
# Google Maps Configuration
# -----------------------------------------------------------------------------
# Google Maps API key for Street View functionality
# Create a free account at https://cloud.google.com/ to obtain your API key
# Required API: Street View Static API
# This key will be bundled with the client-side code
NEXT_PUBLIC_GMAPS_KEY=your_google_maps_api_key_here

# -----------------------------------------------------------------------------
# Google Tag Manager
# -----------------------------------------------------------------------------
# GTM container ID for analytics and conversion tracking
# Create a GTM account at https://tagmanager.google.com/ to obtain your container ID
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# -----------------------------------------------------------------------------
# UserWay Accessibility Widget
# -----------------------------------------------------------------------------
# Optional. Leave blank for free tier (no account needed).
# To upgrade: create an account at https://userway.org/ and paste the account
# ID here for custom branding, analytics, and additional features.
NEXT_PUBLIC_USERWAY_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# Revalidation
# -----------------------------------------------------------------------------
# Shared secret used to authorize external callers of /api/revalidate.
# Same-origin admin requests don't need it; set this for any backend service
# (or webhook) that needs to trigger a Next.js cache tag revalidation.
REVALIDATE_SECRET=change-me-in-production

# Admin API security - PEM contents of the backend JWT public key
# (backend/keys/public.pem). Required for /api/admin/* routes to work.
# JWT_PUBLIC_KEY=
